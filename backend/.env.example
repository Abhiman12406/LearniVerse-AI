# ==============================================================================
# LearniVerse-AI: Backend Environment Variables
# ==============================================================================

# Groq Cloud API Key for Speech-to-Text Whisper transcription (whisper-large-v3)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key for Feynman Multimodal Reasoning & Pedagogical Diagnosis
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Optional: n8n Workflow Webhook URL for external visual orchestration
# If unset or offline, backend automatically falls back to internal resilient engine
N8N_WEBHOOK_URL=http://localhost:5678/webhook/feynman-request

# FastAPI Backend Base URL
FASTAPI_BACKEND_URL=http://localhost:8000
