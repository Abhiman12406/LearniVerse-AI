# ==============================================================================
# LearniVerse-AI: Backend Environment Variables
# ==============================================================================

# Groq Cloud API Key for Speech-to-Text Whisper transcription (whisper-large-v3)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key for Feynman Multimodal Reasoning & Pedagogical Diagnosis
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Optional: n8n Workflow Webhook URL for external visual orchestration
# If unset or offline, backend automatically falls back to internal resilient engine
N8N_WEBHOOK_URL=http://localhost:5678/webhook/feynman-request

# FastAPI Backend Base URL
FASTAPI_BACKEND_URL=http://localhost:8000

# Neo4j Graph Database (Prerequisite Knowledge Graph DAG)
# If unconfigured or unreachable, backend seamlessly uses in-memory NetworkX DAG
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Redis LangCache (Semantic Caching for LLM Pedagogical Invocations)
# If unconfigured or unreachable, backend seamlessly uses in-memory semantic fallback
LANGCACHE_SERVER_URL=https://your-langcache-instance.redis.cloud
LANGCACHE_CACHE_ID=learniverse-cache
LANGCACHE_API_KEY=your_redis_langcache_api_key_here
LANGCACHE_SIMILARITY_THRESHOLD=0.85
LANGCACHE_TTL=86400
